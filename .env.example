# App
NEXT_PUBLIC_APP_NAME=MatchProof
NEXT_PUBLIC_APP_ENV=development

# TxLINE network
TXLINE_NETWORK=mainnet
TXLINE_SERVICE_LEVEL=12
TXLINE_API_ORIGIN=https://txline.txodds.com
TXLINE_API_BASE_URL=https://txline.txodds.com/api

# TxLINE auth
TXLINE_GUEST_JWT=
TXLINE_API_TOKEN=

# Operator controls
MATCHPROOF_OPERATOR_KEY=
ENABLE_PUBLIC_EXPORT=false

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TXLINE_PROGRAM_ID=9ExbZjAapQww1vfcisDmrngPinHTEfpjYRWMunJgcKaA
TXLINE_TXL_TOKEN_MINT=Zhw9TVKp68a1QrftncMSd6ELXKDtpVMNuMGr1jNwdeL

# Database
# Runtime connection: Supabase transaction pooler URL, usually port 6543.
# This is what the deployed Next.js app should use for normal Prisma queries.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migration connection: Supabase direct connection or session pooler URL.
# Prisma migrate uses this through datasource directUrl to avoid transaction-pooler migration hangs.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Local SQLite demo only:
# DATABASE_URL="file:./dev.db"

# Demo
# true seeds local/demo fallback data; false uses real TxLINE ingestion controls.
ENABLE_DEMO_MODE=true
